# Supabase (Project Settings → API). Only the publishable key is needed: all access goes
# through SECURITY DEFINER RPCs (see supabase/schema.sql); tables have RLS with no public policies.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Reference only — the /admin password is verified against a bcrypt hash inside Supabase.
ADMIN_PASSWORD=
